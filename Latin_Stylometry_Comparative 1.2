        "\n",
        "    if \"case_distribution\" in stats:\n",
        "        print(\"POS distribution:\", {k: round(v, 3) for k, v in stats[\"pos_distribution\"].items()})\n",
        "        print(\"Case distribution:\", {k: round(v, 3) for k, v in stats[\"case_distribution\"].items()})\n",
        "        print(\"Tense distribution:\", {k: round(v, 3) for k, v in stats[\"tense_distribution\"].items()})\n",
        "        print(\"Mood distribution:\", {k: round(v, 3) for k, v in stats[\"mood_distribution\"].items()})\n",
        "        print(\"Voice distribution:\", {k: round(v, 3) for k, v in stats[\"voice_distribution\"].items()})\n",
        "\n",
        "        print()\n",
        "\n",
        "def compare_stats(stats_a, stats_b):\n",
        "    \"\"\"Print two stylometry profiles side by side.\"\"\"\n",
        "    label_a, label_b = stats_a[\"label\"], stats_b[\"label\"]\n",
        "    col_w = 28\n",
        "\n",
        "    def row(name, val_a, val_b):\n",
        "        print(f\"{name:<28}{str(val_a):<{col_w}}{str(val_b)}\")\n",
        "\n",
        "    print(f\"{'':<28}{label_a:<{col_w}}{label_b}\")\n",
        "    print(\"-\" * (28 + col_w * 2))\n",
        "\n",
        "    row(\"Total words\", stats_a[\"total_words\"], stats_b[\"total_words\"])\n",
        "    row(\"Different words\", stats_a[\"unique_words\"], stats_b[\"unique_words\"])\n",
        "    row(\"Vocab diversity\", round(stats_a[\"vocab_diversity\"], 4), round(stats_b[\"vocab_diversity\"], 4))\n",
        "    row(\"Avg word length\", round(stats_a[\"avg_word_length\"], 2), round(stats_b[\"avg_word_length\"], 2))\n",
        "    row(\"Num sentences\", stats_a[\"num_sentences\"], stats_b[\"num_sentences\"])\n",
        "    row(\"Avg sentence length\", round(stats_a[\"avg_sentence_length\"], 2), round(stats_b[\"avg_sentence_length\"], 2))\n",
        "    row(\"Enclitic count\", stats_a[\"enclitic_count\"], stats_b[\"enclitic_count\"])\n",
        "    print()\n",
        "\n",
        "    print(f\"Most common words — {label_a}: {stats_a['most_common']}\")\n",
        "    print(f\"Most common words — {label_b}: {stats_b['most_common']}\")\n",
        "    print()\n",
        "\n",
        "    print(f\"Function-word profile (top 5) — {label_a}:\",\n",
        "          dict(list(stats_a[\"function_word_profile\"].items())[:5]))\n",
        "    print(f\"Function-word profile (top 5) — {label_b}:\",\n",
        "          dict(list(stats_b[\"function_word_profile\"].items())[:5]))\n",
        "    print()\n",
        "\n",
        "    if \"case_distribution\" in stats_a and \"case_distribution\" in stats_b:\n",
        "        for dist_name in [\"pos_distribution\", \"case_distribution\", \"tense_distribution\",\n",
        "                          \"mood_distribution\", \"voice_distribution\"]:\n",
        "            da = {k: round(v, 3) for k, v in stats_a[dist_name].items()}\n",
        "            db = {k: round(v, 3) for k, v in stats_b[dist_name].items()}\n",
        "            print(f\"{dist_name} — {label_a}: {da}\")\n",
        "            print(f\"{dist_name} — {label_b}: {db}\")\n",
        "            print()\n",
        "\n",
